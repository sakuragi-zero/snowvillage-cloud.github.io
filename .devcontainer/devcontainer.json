{
  "name": "snowvillage-site",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "postCreateCommand": "npm install && npx playwright install --with-deps chromium",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "Static site preview" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["stylelint.vscode-stylelint", "dbaeumer.vscode-eslint"]
    }
  }
}
