{
  "name": "SnowVillage Static Site",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "workspaceFolder": "/workspaces/snowvillage-cloud.github.io",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/snowvillage-cloud.github.io,type=bind,consistency=cached",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "SnowVillage Website",
      "onAutoForward": "openPreview"
    }
  }
}
